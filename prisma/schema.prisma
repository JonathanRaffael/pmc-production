generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =====================================================
// ENUM
// =====================================================

enum UserRole {
  ADMIN
  USER
}

enum WeightUnit {
  GRAM
  KG
}

enum QuantityUnit {
  PCS
  METER
}

enum ProductionStatus {
  COMPLETED
  CANCELLED
}

// =====================================================
// PRODUCTION AUDIT ACTION
// =====================================================

enum ProductionAuditAction {
  UPDATE
  DELETE
  RESTORE
}

// =====================================================
// USER
// =====================================================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  productionRecords ProductionRecord[]

  // Production Audit Logs
  productionAuditLogs ProductionAuditLog[] @relation("ProductionAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

// =====================================================
// AREA
// =====================================================

model Area {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  productionRecords ProductionRecord[]

  // Computer Master
  computers Computer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// =====================================================
// SHIFT
// =====================================================

model Shift {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  productionRecords ProductionRecord[]

  // Computer Master
  computers Computer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// =====================================================
// MACHINE
// =====================================================

model Machine {
  id          Int     @id @default(autoincrement())
  machineCode String  @unique
  machineName String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// =====================================================
// COMPUTER MASTER
// =====================================================
// Computer Code diketik manual di Production Page.
//
// Contoh:
//
// Computer Code : HTM-PC-001
// Product       : Product A
// Operator/PIC  : Jonathan
// Area          : Molding
// Shift         : A
//
// Computer Code akan digunakan untuk mencari
// data Product, Operator, Area dan Shift.
// =====================================================

model Computer {
  id Int @id @default(autoincrement())

  // ===================================================
  // COMPUTER CODE
  // ===================================================

  computerCode String @unique

  // ===================================================
  // OPERATOR / PIC
  // ===================================================

  operatorName String?

  // ===================================================
  // PRODUCT
  // ===================================================

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // ===================================================
  // AREA
  // ===================================================

  areaId Int?
  area   Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  // ===================================================
  // SHIFT
  // ===================================================

  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // ===================================================
  // STATUS
  // ===================================================

  isActive Boolean @default(true)

  // ===================================================
  // TIMESTAMP
  // ===================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===================================================
  // INDEX
  // ===================================================

  @@index([productId])
  @@index([areaId])
  @@index([shiftId])
  @@index([operatorName])
  @@index([isActive])
}

// =====================================================
// RAW MATERIAL MASTER
// =====================================================

model RawMaterial {
  id           Int     @id @default(autoincrement())
  materialCode String  @unique
  materialName String
  description  String?

  unit WeightUnit @default(GRAM)

  isActive Boolean @default(true)

  productMaterials         ProductMaterial[]
  productionMaterialUsages ProductionMaterialUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materialName])
  @@index([isActive])
}

// =====================================================
// PRODUCT
// =====================================================

model Product {
  id          Int     @id @default(autoincrement())
  productCode String  @unique
  productName String
  description String?

  // ===================================================
  // SHOT WEIGHT
  // ===================================================
  // Disimpan dalam KG.
  //
  // Contoh:
  // 14.5 gram = 0.0145 KG
  // ===================================================

  shotWeight     Decimal @db.Decimal(12, 6)
  shotWeightUnit String  @default("KG")

  // ===================================================
  // QUANTITY UNIT
  // ===================================================

  quantityUnit QuantityUnit @default(PCS)

  // ===================================================
  // STATUS
  // ===================================================

  isActive Boolean @default(true)

  // ===================================================
  // RELATION
  // ===================================================

  productionTargets ProductionTarget[]

  productionRecords ProductionRecord[]

  productMaterials ProductMaterial[]

  // Computer yang menggunakan product ini
  computers Computer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productName])
  @@index([isActive])
}

// =====================================================
// PRODUCT MATERIAL
// =====================================================

model ProductMaterial {
  id Int @id @default(autoincrement())

  // ===================================================
  // PRODUCT
  // ===================================================

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // ===================================================
  // RAW MATERIAL
  // ===================================================

  rawMaterialId Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  // ===================================================
  // SHOT WEIGHT
  // ===================================================

  shotWeight Decimal @db.Decimal(12, 3)

  shotWeightUnit WeightUnit @default(GRAM)

  // ===================================================
  // STATUS
  // ===================================================

  isActive Boolean @default(true)

  // ===================================================
  // TIMESTAMP
  // ===================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===================================================
  // UNIQUE
  // ===================================================

  @@unique([productId, rawMaterialId])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([isActive])
}

// =====================================================
// PRODUCTION TARGET
// =====================================================

model ProductionTarget {
  id Int @id @default(autoincrement())

  // ===================================================
  // PRODUCT
  // ===================================================

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // ===================================================
  // TARGET 8 JAM
  // ===================================================

  target8H Decimal @db.Decimal(12, 2)

  // ===================================================
  // PERIODE BERLAKU
  // ===================================================

  effectiveFrom DateTime
  effectiveTo   DateTime?

  // ===================================================
  // STATUS
  // ===================================================

  isActive Boolean @default(true)

  // ===================================================
  // TIMESTAMP
  // ===================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===================================================
  // INDEX
  // ===================================================

  @@index([productId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([isActive])
  @@index([productId, effectiveFrom])
}

// =====================================================
// PRODUCTION RECORD
// =====================================================

model ProductionRecord {
  id Int @id @default(autoincrement())

  // ===================================================
  // PRODUCTION DATE
  // ===================================================

  productionDate DateTime

  // ===================================================
  // MACHINE
  // ===================================================

  machineNo String?

  // ===================================================
  // AREA
  // ===================================================

  areaId Int
  area   Area @relation(fields: [areaId], references: [id])

  // ===================================================
  // SHIFT
  // ===================================================

  shiftId Int
  shift   Shift @relation(fields: [shiftId], references: [id])

  // ===================================================
  // PRODUCT
  // ===================================================

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // ===================================================
  // COMPUTER CODE
  // ===================================================
  // Diisi dari Computer Code yang diketik user.
  // ===================================================

  computerCode String?

  // ===================================================
  // OPERATOR / PIC
  // ===================================================

  operatorName String?

  // ===================================================
  // PRODUCTION INPUT
  // ===================================================

  outputQty Decimal @db.Decimal(12, 2)

  okQty Decimal @db.Decimal(12, 2)

  // Actual raw material dalam KG
  actualRm Decimal @db.Decimal(12, 3)

  // ===================================================
  // OTHER
  // ===================================================

  otReplace String?

  remarks String?

  // ===================================================
  // STATUS
  // ===================================================

  status ProductionStatus @default(COMPLETED)

  // ===================================================
  // INPUT USER
  // ===================================================

  inputById Int
  inputBy   User @relation(fields: [inputById], references: [id])

  // ===================================================
  // MATERIAL USAGE
  // ===================================================

  materialUsages ProductionMaterialUsage[]

  // ===================================================
  // TIMESTAMP
  // ===================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===================================================
  // SOFT DELETE
  // ===================================================

  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  // ===================================================
  // AUDIT UPDATE
  // ===================================================

  updatedBy String?

  // ===================================================
  // INDEX
  // ===================================================

  @@index([productionDate])
  @@index([machineNo])
  @@index([areaId])
  @@index([shiftId])
  @@index([productId])
  @@index([computerCode])
  @@index([inputById])
  @@index([status])
  @@index([deletedAt])
  @@index([productionDate, productId])
  @@index([productionDate, areaId])
  @@index([productionDate, shiftId])
  @@index([productionDate, machineNo])
  @@index([productionDate, computerCode])
}

// =====================================================
// PRODUCTION AUDIT LOG
// =====================================================

model ProductionAuditLog {
  id Int @id @default(autoincrement())

  // ===================================================
  // PRODUCTION RECORD ID
  // ===================================================
  // Tidak menggunakan foreign key ke ProductionRecord
  // agar audit tetap tersimpan secara independen.
  // ===================================================

  recordId Int

  // ===================================================
  // ACTION
  // ===================================================

  action ProductionAuditAction

  // ===================================================
  // ADMINISTRATOR
  // ===================================================

  actorId Int
  actor   User @relation("ProductionAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  // Snapshot email administrator
  actorEmail String

  // ===================================================
  // REASON
  // ===================================================

  reason String?

  // ===================================================
  // BEFORE & AFTER DATA
  // ===================================================

  beforeData Json?
  afterData  Json?

  // ===================================================
  // TIMESTAMP
  // ===================================================

  createdAt DateTime @default(now())

  // ===================================================
  // INDEX
  // ===================================================

  @@index([recordId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

// =====================================================
// PRODUCTION MATERIAL USAGE
// =====================================================

model ProductionMaterialUsage {
  id Int @id @default(autoincrement())

  // ===================================================
  // PRODUCTION RECORD
  // ===================================================

  productionRecordId Int
  productionRecord   ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)

  // ===================================================
  // RAW MATERIAL
  // ===================================================

  rawMaterialId Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  // ===================================================
  // ACTUAL USAGE
  // ===================================================

  actualUsage Decimal @db.Decimal(12, 3)

  usageUnit WeightUnit @default(GRAM)

  remarks String?

  // ===================================================
  // TIMESTAMP
  // ===================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===================================================
  // UNIQUE
  // ===================================================

  @@unique([productionRecordId, rawMaterialId])
  @@index([productionRecordId])
  @@index([rawMaterialId])
}

// =====================================================
// MOLDING PRODUCT MASTER
// =====================================================

model MoldingProduct {
  id Int @id @default(autoincrement())

  // PRODUCT INFORMATION
  computerCode       String  @unique
  productName        String
  productDescription String?

  hardnessRequirements    String?
  colorRequirements       String?
  rawMaterialRequirements String?

  // MATERIAL PARAMETERS
  // Semua berat disimpan dalam KG
  shotWeight  Decimal @db.Decimal(12, 6)
  setupWeight Decimal @default(0) @db.Decimal(12, 6)

  // PRODUCTION PARAMETERS
  cavity          Int
  materialSetup   Decimal @db.Decimal(12, 2)
  vulcanization   Decimal @db.Decimal(12, 2)
  materialRemoval Decimal @db.Decimal(12, 2)

  // DEFAULT PRODUCTION TIME PER DAY (HOURS)
  productionTime Decimal @db.Decimal(5, 2)

  // STATUS
  isActive Boolean @default(true)

  // RELATIONS
  moldingPOs               MoldingPO[]
  moldingProductionRecords MoldingProductionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productName])
  @@index([isActive])
}

// =====================================================
// MOLDING PURCHASE ORDER
// =====================================================

model MoldingPO {
  id Int @id @default(autoincrement())

  // PRODUCT RELATION
  moldingProductId Int
  moldingProduct   MoldingProduct @relation(fields: [moldingProductId], references: [id], onDelete: Restrict)

  // PO INFORMATION
  poNumber         String   @unique
  poDate           DateTime
  deliveryDeadline DateTime

  // PURCHASE QUANTITY
  actualPOQty Decimal @db.Decimal(14, 2)

  // BUFFER INPUT BY USER
  bufferPercent Decimal @default(0) @db.Decimal(5, 2)

  // AUTOMATIC CALCULATION
  bufferQty  Decimal @default(0) @db.Decimal(14, 2)
  totalPOQty Decimal @default(0) @db.Decimal(14, 2)

  // RELATIONS
  productionPlan MoldingProduction?
  allocations    MoldingPOAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moldingProductId])
  @@index([deliveryDeadline])
  @@index([poDate])
  @@index([moldingProductId, deliveryDeadline])
}

// =====================================================
// MOLDING PRODUCTION PLANNING
// One PO = One Production Plan
// =====================================================

model MoldingProduction {
  id Int @id @default(autoincrement())

  moldingPOId Int       @unique
  moldingPO   MoldingPO @relation(fields: [moldingPOId], references: [id], onDelete: Cascade)

  // PRODUCTION PARAMETER SNAPSHOT
  shotWeight  Decimal @db.Decimal(12, 6)
  setupWeight Decimal @default(0) @db.Decimal(12, 6)

  cavity Int

  materialSetup   Decimal @db.Decimal(12, 2)
  vulcanization   Decimal @db.Decimal(12, 2)
  materialRemoval Decimal @db.Decimal(12, 2)

  // PRODUCTION CALCULATION
  totalDuration Decimal @db.Decimal(12, 2)

  quotaPerHourShot Decimal @db.Decimal(12, 2)
  quotaPerHourPcs  Decimal @db.Decimal(12, 2)

  productionTime         Decimal @db.Decimal(5, 2)
  productionTargetPerDay Decimal @db.Decimal(14, 2)

  // COMPLETION ESTIMATION
  targetCompleteHours Decimal @db.Decimal(14, 2)
  targetCompleteDays  Decimal @db.Decimal(14, 2)

  // RAW MATERIAL REQUIREMENT (KG)
  totalRawMaterial Decimal @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// MOLDING SHIFT
// =====================================================

enum MoldingShift {
  A
  B
}

// =====================================================
// MOLDING PRODUCTION RECORD
// Independent Actual Production
// =====================================================

model MoldingProductionRecord {
  id Int @id @default(autoincrement())

  // PRODUCT RELATION
  moldingProductId Int
  moldingProduct   MoldingProduct @relation(fields: [moldingProductId], references: [id], onDelete: Restrict)

  // PRODUCTION INFORMATION
  productionDate DateTime
  shift          MoldingShift

  machineNo    String?
  operatorName String?

  // PRODUCTION QUANTITY
  outputQty Decimal @db.Decimal(14, 2)
  okQty     Decimal @db.Decimal(14, 2)

  // ACTUAL RAW MATERIAL (KG)
  actualRm Decimal? @db.Decimal(14, 3)

  remarks String?

  // PO ALLOCATION
  allocations MoldingPOAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moldingProductId])
  @@index([productionDate])
  @@index([shift])
  @@index([machineNo])
  @@index([productionDate, moldingProductId])
  @@index([moldingProductId, productionDate, shift])
}

// =====================================================
// MOLDING PO ALLOCATION
// Automatic Allocation Based on Delivery Deadline
// =====================================================

model MoldingPOAllocation {
  id Int @id @default(autoincrement())

  // PURCHASE ORDER
  moldingPOId Int
  moldingPO   MoldingPO @relation(fields: [moldingPOId], references: [id], onDelete: Restrict)

  // PRODUCTION RECORD
  productionRecordId Int
  productionRecord   MoldingProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Restrict)

  // ALLOCATED OK QUANTITY
  allocatedQty Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([moldingPOId, productionRecordId])
  @@index([moldingPOId])
  @@index([productionRecordId])
}
