generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


// =====================================================
// ENUM
// =====================================================

enum UserRole {
  ADMIN
  USER
}


// =====================================================
// USER
// =====================================================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  productionRecords ProductionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}


// =====================================================
// AREA
// =====================================================

model Area {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  productionRecords ProductionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// =====================================================
// SHIFT
// =====================================================

model Shift {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  productionRecords ProductionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// =====================================================
// PRODUCT
// =====================================================

model Product {
  id          Int     @id @default(autoincrement())
  productCode String  @unique
  productName String
  description String?
  isActive    Boolean @default(true)

  productionTargets ProductionTarget[]
  productionRecords ProductionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}


// =====================================================
// PRODUCTION TARGET
// =====================================================

model ProductionTarget {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  target8H Decimal @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
}


// =====================================================
// PRODUCTION RECORD
// =====================================================

model ProductionRecord {
  id Int @id @default(autoincrement())

  productionDate DateTime

  areaId Int
  area   Area @relation(fields: [areaId], references: [id])

  shiftId Int
  shift   Shift @relation(fields: [shiftId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  operatorName String?
  computerCode String?

  outputQty Decimal @db.Decimal(12, 2)
  okQty     Decimal @db.Decimal(12, 2)
  actualRm  Decimal @db.Decimal(12, 3)

  otReplace String?
  remarks   String?

  inputById Int
  inputBy   User @relation(fields: [inputById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionDate])
  @@index([areaId])
  @@index([shiftId])
  @@index([productId])
  @@index([inputById])
}